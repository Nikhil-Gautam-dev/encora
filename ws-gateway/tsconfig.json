{
    "compilerOptions": {
        "target": "es2022",
        "module": "ESNext",
        "moduleResolution": "Node",
        "outDir": "dist",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "types": [
            "node"
        ],
        "paths": {
            "@": [
                "./src/"
            ]
        }
    },
    "include": [
        "src",
        "*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}